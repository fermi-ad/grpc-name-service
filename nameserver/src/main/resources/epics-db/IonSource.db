##############################################################################
# BinaryHeartBeat.template
# Function: To check for a change of state of a binary heartbeat bit
#
# Written by Pierrick Hanlet, 19 November 2025
#
##############################################################################
record(mbbi,"A0TST:IS_BLE_HVPLC:HBstatus") {
  field(DESC,"HVPLC: Heartbeat")
  field(VAL, "0")
  field(PINI,"YES")
  field(ZRVL,"0")
  field(ZRST,"OK")
  field(ZRSV,"NO_ALARM")
  field(ONVL,"1")
  field(ONST,"OK")
  field(ONSV,"NO_ALARM")
  field(TWVL,"2")
  field(TWST,"Error")
  field(TWSV,"MAJOR")
}
record(longin,"A0TST:IS_BLE_HVPLC:Timer") {
  field(DESC,"HVPLC: time")
  field(VAL, "0")
  field(PINI,"YES")
}
record(longin,"A0TST:IS_BLE_HVPLC:ResetTime") {
  field(DESC,"HVPLC: time")
  field(VAL, "4")
  field(PINI,"YES")
}
record(longin,"A0TST:IS_BLE_HVPLC:MaxErr") {
  field(DESC,"HVPLC: time")
  field(VAL, "4")
  field(PINI,"YES")
}
record(calcout,"A0TST:IS_BLE_HVPLC:calTime") {
  field(DESC,"HVPLC: time")
  field(SCAN,"1 second")
  field(INPA,"A0TST:IS_BLE_HVPLC:Timer")
  field(INPB,"A0TST:IS_BLE_HVPLC:ResetTime")
  field(CALC,"A<B?A+1:0")
  field(OUT, "A0TST:IS_BLE_HVPLC:Timer.VAL")
  field(FLNK,"A0TST:IS_BLE_HVPLC:Timer.PROC")
}

record(bi,"A0TST:IS_BLE_HVPLC:LastVal") {
  field(DESC,"HVPLC: previous")
  field(DTYP,"Soft Channel")
  field(VAL, "0")
  field(PINI,"YES")
}
record(longin,"A0TST:IS_BLE_HVPLC:ErrCnt") {
  field(DESC,"HVPLC: Error Count")
  field(VAL, "0")
  field(PINI,"YES")
  field(HHSV,"MAJOR")
  field(HIHI,"4")
}
record(calcout,"A0TST:IS_BLE_HVPLC:checkChange") {
  field(DESC,"HVPLC: check for change")
  field(SCAN,"1 second")
  field(INPA,"A0TST:IS_BLE_HVPLC:Timer")
  field(INPB,"A0TST:IS_BLE_PLC2024:rB2IT")
  field(INPC,"A0TST:IS_BLE_HVPLC:LastVal")
  field(INPD,"A0TST:IS_BLE_HVPLC:ErrCnt")
  field(CALC,"A<=1&&B#C&&B=0?3:A<=1&&B#C&&B=1?5:A<=1&&B=C?8:0")
  field(OUT, "A0TST:IS_BLE_HVPLC:seqChange.SELN")
  field(FLNK,"A0TST:IS_BLE_HVPLC:seqChange")
}
record(seq,"A0TST:IS_BLE_HVPLC:seqChange") {
  field(DO1, "0")
  field(LNK1,"A0TST:IS_BLE_HVPLC:ErrCnt PP")
  field(DO2, "0")
  field(LNK2,"A0TST:IS_BLE_HVPLC:LastVal PP")
  field(DO3, "1")
  field(LNK3,"A0TST:IS_BLE_HVPLC:LastVal PP")
  field(DO4, "1")
  field(LNK4,"A0TST:IS_BLE_HVPLC:calErrCnt.PROC")
  field(SELM,"Mask")
  field(SELN,"0")
}
record(calcout,"A0TST:IS_BLE_HVPLC:calErrCnt") {
  field(DESC,"HVPLC: update error count")
  field(SCAN,"Passive")
  field(INPA,"A0TST:IS_BLE_HVPLC:ErrCnt")
  field(CALC,"A+1")
  field(OUT, "A0TST:IS_BLE_HVPLC:ErrCnt.VAL PP")
  field(FLNK,"A0TST:IS_BLE_HVPLC:calError.PROC")
}
record(calcout,"A0TST:IS_BLE_HVPLC:calError") {
  field(DESC,"HVPLC: update error count")
  field(SCAN,"Passive")
  field(INPA,"A0TST:IS_BLE_HVPLC:ErrCnt")
  field(INPB,"A0TST:IS_BLE_HVPLC:MaxErr")
  field(INPC,"A0TST:IS_BLE_PLC2024:rB2IT")
  field(CALC,"A>=4?B:C")
  field(OUT, "A0TST:IS_BLE_HVPLC:HBstatus.VAL")
  field(FLNK,"A0TST:IS_BLE_HVPLC:HBstatus.PROC")
}
###########################################################################
### Pack individual bits into 16-bit word
###
### Create 16-bit mbbi's for trips
### Written by Pierrick Hanlet, 4 September 2024
###
###########################################################################
### BIAS
record(calc,"A0TST:IS_BLE_BIAS:calStatus1") {
  field(DESC,"BIAS: Status")
  field(SCAN,"1 second")
  field(INPA,"A0TST:IS_BLE_PLC2000:rBIT")
  field(INPB,"A0TST:IS_BLE_PLC2001:rBIT")
  field(INPC,"A0TST:IS_BLE_PLC2002:rBIT")
  field(INPD,"A0TST:IS_BLE_PLC2003:rBIT")
  field(INPE,"A0TST:IS_BLE_PLC2004:rBIT")
  field(INPF,"A0TST:IS_BLE_PLC2005:rBIT")
  field(INPG,"A0TST:IS_BLE_PLC2006:rBIT")
  field(INPH,"A0TST:IS_BLE_PLC2007:rBIT")
  field(CALC,"A*1+B*2+C*4+D*8+E*16+F*32+G*64+H*128")
  field(FLNK,"A0TST:IS_BLE_BIAS:calStatus2")
}
record(calc,"A0TST:IS_BLE_BIAS:calStatus2") {
  field(DESC,"BIAS: Status")
  field(SCAN,"Passive")
  field(INPA,"A0TST:IS_BLE_PLC2008:rBIT")
  field(INPB,"A0TST:IS_BLE_PLC2009:rBIT")
  field(INPC,"A0TST:IS_BLE_PLC2010:rBIT")
  field(INPD,"A0TST:IS_BLE_PLC2011:rBIT")
  field(INPE,"A0TST:IS_BLE_PLC2012:rBIT")
  field(INPF,"A0TST:IS_BLE_PLC2013:rBIT")
  field(INPG,"A0TST:IS_BLE_PLC2014:rBIT")
  field(INPH,"A0TST:IS_BLE_PLC2015:rBIT")
  field(CALC,"A*256+B*512+C*1024+D*2048+E*4096+F*8192+G*16384+H*32768")
  field(FLNK,"A0TST:IS_BLE_BIAS:calStatus")
}
record(calc,"A0TST:IS_BLE_BIAS:calStatus") {
  field(DESC,"BIAS: Status")
  field(SCAN,"Passive")
  field(INPA,"A0TST:IS_BLE_BIAS:calStatus1")
  field(INPB,"A0TST:IS_BLE_BIAS:calStatus2")
  field(CALC,"A+B")
  field(FLNK,"A0TST:IS_BLE_BIAS:Status")
}

record(mbbi,"A0TST:IS_BLE_BIAS:Status") {
  field(DESC,"BIAS: Status")
  field(SCAN,"Passive")
  field(INP, "A0TST:IS_BLE_BIAS:calStatus")
  field(ZRVL,"1")
  field(ONVL,"2")
  field(TWVL,"4")
  field(THVL,"8")
  field(FRVL,"16")
  field(FVVL,"32")
  field(SXVL,"64")
  field(SVVL,"128")
  field(EIVL,"256")
  field(NIVL,"512")
  field(TEVL,"1024")
  field(ELVL,"2048")
  field(TVVL,"4096")
  field(TTVL,"8192")
  field(FTVL,"16384")
  field(FFVL,"32768")

  field(ZRSV,"0")
  field(ONSV,"0")
  field(TWSV,"0")
  field(THSV,"0")
  field(FRSV,"0")
  field(FVSV,"0")
  field(SXSV,"0")
  field(SVSV,"0")
  field(EISV,"0")
  field(NISV,"0")
  field(TESV,"0")
  field(ELSV,"0")
  field(TVSV,"0")
  field(TTSV,"0")
  field(FTSV,"0")
  field(FFSV,"0")
}
