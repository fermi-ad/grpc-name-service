##############################################################################
# LabJack values to Sorenson channels
#
# Written by Pierrick Hanlet, 20 February 2026
#
##############################################################################
record(calc,"A0TST:IS_BLE_FLMNT:Voltage") {
  field(DESC,"FLMNT: voltage")
  field(SCAN,"1 second")
  field(INPA,"A0TST:IS_BLE_LJM:Ai0 PP")
  field(INPB,"0.8")
  field(CALC,"A*B")
  field(EGU, "V")
  field(FLNK,"A0TST:IS_BLE_FLMNT:Current.PROC")
}
record(calc,"A0TST:IS_BLE_FLMNT:Current") {
  field(DESC,"FLMNT: current")
  field(SCAN,"Passive")
  field(INPA,"A0TST:IS_BLE_LJM:Ai1 PP")
  field(INPB,"35.0")
  field(CALC,"A*B")
  field(EGU, "A")
}

record(ao,"A0TST:IS_BLE_FLMNT:sCurrent") {
  field(DESC,"FLMNT: set current")
  field(DTYP,"Soft Channel")
  field(EGU, "A")
  field(DRVL,"0.0")
  field(DRVH,"300.0")
  field(FLNK,"A0TST:IS_BLE_FLMNT:setCurrent")
}
record(calcout,"A0TST:IS_BLE_FLMNT:setCurrent") {
  field(DESC,"FLMNT: set current")
  field(DTYP,"Soft Channel")
  field(SCAN,"Passive")
  field(INPA,"A0TST:IS_BLE_FLMNT:sCurrent")
  field(INPB,"35.0")
  field(CALC,"A/B")
  field(OUT, "A0TST:IS_BLE_LJM:Ao0.VAL")
  field(FLNK,"A0TST:IS_BLE_LJM:Ao0.PROC")
}